
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	 ТипРеквизита = Тип("ПолеФормы");
	 
	 ДЗ_ДобавитьРеквизит.ДобавитьРеквизитКонтактноеЛицоВДокумент(
	ЭтотОбъект, 
	"ДЗ_КонтактноеЛицо", 
	ТипРеквизита, 
	"Объект.ДЗ_КонтактноеЛицо", 
	"Контактное лицо", 
	"ГруппаШапкаПраво");
	
	НоваяГруппа = СозданиеНовойГруппы();
	
	СоздатьСоглСкидку(НоваяГруппа);
	
	КомандаПересчитатьТаблицу = Команды.Добавить("ПересчитатьТаблицу");
	КомандаПересчитатьТаблицу.Заголовок = "Пересчитать таблицу";
	КомандаПересчитатьТаблицу.Действие = "КомандаПересчитатьТаблицу";
	
	КнопкаФормы = Элементы.Добавить("ДЗ_КнопкаПересчитатьТаблицу", Тип("КнопкаФормы"), НоваяГруппа); 
	КнопкаФормы.ИмяКоманды = "ПересчитатьТаблицу";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
КонецПроцедуры

