#Область СлужебныеПроцедурыИФункции

 &НаКлиенте
 Асинх Процедура ДЗ_ПриИзмененииСогласованнаяСкидка()
	 
	 
	 Если Объект.ДЗ_СогласованнаяСкидка > 100 Тогда
		 ОбщегоНазначенияКлиент.СообщитьПользователю("Ошибка! Скидка не может быть больше 100%");
		 Возврат;
	 КонецЕсли;
	 
	 Ответ = Ждать ВопросАсинх("Пересчитать скидку для таблицы?", РежимДиалогаВопрос.ДаНет);	
	 
	 Если Ответ = КодВозвратаДиалога.Да Тогда
		 
		 КомандаПересчитатьТаблицу();
		 
	 Иначе
		 Возврат;
		 
	 КонецЕсли; 
	 
 КонецПроцедуры

&НаКлиенте
 Процедура КомандаПересчитатьТаблицу()
	 
	 Для Каждого ТекущиеДанные Из Объект.Товары Цикл 
		 РассчитатьСуммуСтроки(ТекущиеДанные);
	 КонецЦикла; 
	 
	 
	 Для Каждого ТекСтрока Из Объект.Услуги Цикл 
		 РассчитатьСуммуСтроки(ТекСтрока);
	 КонецЦикла;	 
	 
	 ОбщегоНазначенияКлиент.СообщитьПользователю("Таблицы пересчитаны");
	 
 КонецПроцедуры


//@skip-check module-unused-method
&НаКлиенте
 Процедура КонтактныеЛицаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	 
	 //@skip-check bsl-legacy-check-dynamic-feature-access
	 ДЗ_ВыборКонтактногоЛицаКлиент.КонтактныеЛицаВыбор(Объект.Контрагент, Элемент, СтандартнаяОбработка);
	 
 КонецПроцедуры

&НаСервере
Функция СозданиеНовойГруппы()
	Перем НоваяГруппа;
	
	НоваяГруппа = Элементы.Добавить("ГруппаСкидка", Тип("ГруппаФормы"), Элементы.Найти("ГруппаШапкаЛево"));
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок = "Группа согласованная скидка";
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
    НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
    НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
    НоваяГруппа.РастягиватьПоГоризонтали = Ложь;
	Возврат НоваяГруппа;
КонецФункции

&НаСервере
Процедура СоздатьСоглСкидку(НоваяГруппа)
	Перем НовыйРеквизит;
	НовыйРеквизит = Элементы.Добавить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"), НоваяГруппа); 
	НовыйРеквизит.Вид = ВидПоляФормы.ПолеВвода;
	НовыйРеквизит.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	НовыйРеквизит.Заголовок = "Согласованная скидка"; 
	
	//@skip-check bsl-legacy-check-string-literal
	НовыйРеквизит.УстановитьДействие("ПриИзменении", "ДЗ_ПриИзмененииСогласованнаяСкидка");
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	ПроцентСкидки = Объект.ДЗ_СогласованнаяСкидка / 100;
	
	ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки) 
		- ПроцентСкидки * (ТекущиеДанные.Цена * ТекущиеДанные.Количество); 
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

